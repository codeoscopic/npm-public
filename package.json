{
  "name": "npm-public",
  "version": "3.0.0-next.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "publish": "node scripts/publish.mjs",
    "link": "turbo run link",
    "format": "prettier --write \"packages/**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "release": "commit-and-tag-version --no-verify",
    "release-next": "npm run release -- --prerelease next",
    "release-minor": "npm run release -- --release-as minor",
    "release-patch": "npm run release -- --release-as patch",
    "upgrade-libs": "ncu --deep -u -i --format group"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.5",
    "commit-and-tag-version": "^13.3.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.0.0",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2"
  },
  "engines": {
    "npm": ">=7.0.0",
    "node": ">=14.0.0"
  },
  "packageManager": "npm@11.19.0",
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
