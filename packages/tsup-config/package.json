{
  "name": "@codeoscopic/tsup-config",
  "version": "2.0.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeoscopic/npm-public.git"
  },
  "files": [
    "dist/**"
  ],
  "typings": "./dist/client.d.ts",
  "scripts": {
    "build": "tsc",
    "postbuild": "cp src/react-import.js dist && cp src/client.d.ts dist",
    "dev": "npm run build -- --watch --incremental",
    "lint": "TIMING=1 eslint src --fix && tsc --noEmit",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "publish": "npm publish",
    "link": "npm link"
  },
  "devDependencies": {
    "@codeoscopic/eslint-config": "*",
    "@codeoscopic/tsconfig": "*",
    "tsup": "^9.0.0"
  },
  "peerDependencies": {
    "tsup": "^9.0.0"
  },
  "dependencies": {
    "postcss": "^8.4.27",
    "postcss-modules": "^4.3.1",
    "postcss-nested": "^8.0.1"
  }
}
